ASTRA_HOST=0.0.0.0
ASTRA_PORT=8000
ASTRA_SENSOR_MODE=simulated
ASTRA_BIOMETRICS_MODE=simulated
ASTRA_SUIT_TELEMETRY_MODE=simulated
# On Raspbian Buster, live mode uses the system Sense HAT driver:
# ASTRA_SENSE_HAT_PYTHON=/usr/bin/python3
ASTRA_SIMULATION_PROFILE=cycle
ASTRA_SAMPLE_INTERVAL_SECONDS=1.0
ASTRA_IMU_SAMPLE_HZ=20
ASTRA_TASK_INTERVAL_SECONDS=300.0
ASTRA_LLM_ENABLED=true
ASTRA_LLM_BINARY_PATH=/home/pi/llm-benchmark/llama.cpp/build/bin/llama-completion
ASTRA_LLM_MODEL_PATH=/home/pi/llm-benchmark/models/gemma-3-270m-it-Q4_K_M.gguf
ASTRA_LLM_TIMEOUT_SECONDS=120.0
ASTRA_LLM_MAX_TOKENS=32
ASTRA_LLM_MAX_TEMPERATURE=0.4
ASTRA_LLM_THREADS=4
ASTRA_DATABASE_PATH=data/astra.db
ASTRA_BASELINE_SAMPLES=20
ASTRA_STATE_CONFIRMATION_SAMPLES=2
ASTRA_RESTORE_BASELINE=true
